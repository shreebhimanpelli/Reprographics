# Google Drive Service Account Configuration
GOOGLE_CLIENT_EMAIL="your-service-account@your-project-id.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_ROOT_FOLDER_ID="your-google-drive-folder-id"

# Gmail SMTP Configuration
SMTP_EMAIL="reprographics@flame.edu.in"
SMTP_PASSWORD="your-16-letter-app-password"

# Google OAuth 2.0 Client ID (Public for frontend OAuth)
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# HDFC SmartGateway (PayZapp / UPI merchant API)
# Use HDFC_ENV=production on live; omit or set sandbox for UAT.
HDFC_ENV="sandbox"
HDFC_API_KEY="your-hdfc-smartgateway-api-key"
HDFC_MERCHANT_ID="your-merchant-id"
HDFC_PAYMENT_PAGE_CLIENT_ID="hdfcmaster"
HDFC_RESELLER_ID="hdfc_reseller"
HDFC_RETURN_URL="https://flamereprographics.in/payment/return"
HDFC_WEBHOOK_USERNAME="your-webhook-username"
HDFC_WEBHOOK_PASSWORD="your-webhook-password"
